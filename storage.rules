rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Creature models
    match /creatures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Player avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // POI images
    match /poi/{poiId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

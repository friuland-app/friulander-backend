rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Creatures collection (public read, admin write)
    match /creatures/{creatureId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // World creatures (spawned creatures)
    match /world_creatures/{spawnId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // POI collection (public read, admin write)
    match /poi/{poiId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Battles collection
    match /battles/{battleId} {
      allow read, write: if request.auth != null;
    }
    
    // Quests collection
    match /quests/{questId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

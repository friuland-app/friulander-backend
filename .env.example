# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Configuration
# Get your service account key from Firebase Console > Project Settings > Service Accounts
# Copy the JSON content and paste it as a single line (replace newlines with \n)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Firebase Project ID
FIREBASE_PROJECT_ID=friulander

# CORS Configuration
CORS_ORIGIN=*
